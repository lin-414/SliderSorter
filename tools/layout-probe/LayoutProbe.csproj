<Project Sdk="Microsoft.NET.Sdk">

  <!-- 布局溢出探针：只引用被测工程、只读 XAML，不写回仓库任何文件。
       加载真实资源字典 + 真实窗口 XAML，离屏 Measure/Arrange 后读 ActualWidth。
       用法见 Program.cs 顶部注释；退出码 0 = 无溢出/裁切，1 = 有命中。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LayoutProbe</AssemblyName>
    <RootNamespace>LayoutProbe</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>LayoutProbe.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BSGroupGenerator.Wpf\BSGroupGenerator.Wpf.csproj" />
  </ItemGroup>

</Project>
