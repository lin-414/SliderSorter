<Project Sdk="Microsoft.NET.Sdk">

  <!-- 3D 预览渲染探针：只引用被测工程，只读真实数据，不写回仓库任何源文件。
       三种模式（用法见 Program.cs 顶部）：
         calib  合成网格走生产 AddShape，验轴映射 / UV / 背面剔除
         stats  真实 .nif 的几何体检，核对 NifPreviewModel.cs 注释里那些"实测"断言
         shots  真实服装走生产 OutputConflictPage 出多视角 PNG
       退出码 0 = 探针自己跑通了（判定结论打在输出里），1 = 出错。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PreviewProbe</AssemblyName>
    <RootNamespace>PreviewProbe</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>PreviewProbe.Program</StartupObject>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SliderSorter.Wpf\SliderSorter.Wpf.csproj" />
  </ItemGroup>

</Project>
