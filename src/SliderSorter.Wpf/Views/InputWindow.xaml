<Window x:Class="SliderSorter.Wpf.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource B.Window}" FontFamily="{StaticResource AppFont}" FontSize="{DynamicResource Type.H3}"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="14">
        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource B.Text}" />
        <TextBox Margin="0,10,0,12" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" x:Name="Box" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource L.Btn_Ok}" IsDefault="True" Click="Ok_Click" MinWidth="75" MinHeight="28" />
            <Button Content="{DynamicResource L.Btn_Cancel}" IsCancel="True" MinWidth="75" MinHeight="28" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
