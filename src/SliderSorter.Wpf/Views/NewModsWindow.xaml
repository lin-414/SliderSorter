<Window x:Class="SliderSorter.Wpf.Views.NewModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SliderSorter.Wpf.Services"
        Title="{DynamicResource L.NewMods_Title}" Width="580" Height="600" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource B.Window}"
        FontFamily="{StaticResource AppFont}" FontSize="13" Style="{StaticResource AppWindow}">
    <DockPanel>
        <TextBlock x:Name="TopLabel" DockPanel.Dock="Top" Margin="10,10,10,4" TextWrapping="Wrap"
                   Foreground="{DynamicResource B.Text}" />
        <!-- 两个过滤框与主界面/「查看组」同一套：左管服装名，右管模组名与分隔符名。
             星号列而非固定宽度，长译文下也不会被挤出窗口 -->
        <Grid DockPanel.Dock="Top" Margin="10,0,10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Grid.Column="0" ui:Watermark.Text="{DynamicResource L.NewMods_FilterOutfits}" />
            <TextBox x:Name="ModFilterBox" Grid.Column="2" ui:Watermark.Text="{DynamicResource L.NewMods_FilterMods}" />
        </Grid>
        <!-- 过滤生效时才占位：说明"当前显示几个 / 还剩几个待归组" -->
        <TextBlock x:Name="FilterCountLabel" DockPanel.Dock="Top" Margin="10,4,10,0" Visibility="Collapsed"
                   Foreground="{DynamicResource B.TextDim}" TextTrimming="CharacterEllipsis" />
        <StackPanel DockPanel.Dock="Bottom" Margin="10,4,10,10">
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{DynamicResource L.NewMods_Target}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource B.Text}" />
                <ComboBox x:Name="GroupCombo" Width="260" Height="30"
                          DisplayMemberPath="Name" VerticalContentAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="SummaryLabel" Margin="0,4,0,0" Foreground="{DynamicResource B.TextDim}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="PresetsButton" Click="Presets_Click" MinWidth="140" MinHeight="28" Margin="0,0,8,0" />
                <Button Content="{DynamicResource L.Btn_Close}" IsCancel="True" MinWidth="84" MinHeight="28" Margin="0,0,8,0" />
                <Button x:Name="ApplyButton" Content="{DynamicResource L.NewMods_AddSelected}" Style="{StaticResource PrimaryButton}"
                        Click="Apply_Click" MinWidth="110" />
            </StackPanel>
        </StackPanel>
        <TreeView x:Name="Tree" Margin="10,4,10,0" ItemTemplate="{StaticResource NodeRowTemplate}" />
    </DockPanel>
</Window>
