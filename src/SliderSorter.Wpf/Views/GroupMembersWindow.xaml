<Window x:Class="SliderSorter.Wpf.Views.GroupMembersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SliderSorter.Wpf.Services"
        Width="760" Height="680" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource B.Window}" FontFamily="{StaticResource AppFont}" FontSize="{DynamicResource Type.H3}"
        Style="{StaticResource AppWindow}">
    <DockPanel>
        <!-- 两个过滤框与「新模组」/ 主界面同一套：左管成员名，右管模组名与分隔符名。
             星号列而非固定 240：原先两个 240 加 10 间隔共 490，比 MinWidth=500 只余 10——
             一旦有译文把水位线占位文字撑长，或用户在 500 宽下拖窄到极限，右框就会被挤出可视区。
             星列让它随窗口自适应，长译文下也压得住。
             宽度同时从 640 提到 760：本页列的是"某个组的全部成员"，
             成员名与「组内 x/y」徽标比新模组页更长，宽一点少一次横向滚动。 -->
        <Grid DockPanel.Dock="Top" Margin="10,10,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Grid.Column="0" ui:Watermark.Text="{DynamicResource L.Members_FilterMembers}" />
            <TextBox x:Name="ModFilterBox" Grid.Column="2" ui:Watermark.Text="{DynamicResource L.Members_FilterMods}" />
        </Grid>
        <TextBlock x:Name="CountLabel" DockPanel.Dock="Bottom" Margin="10,4,10,4"
                   Foreground="{DynamicResource B.TextDim}" TextTrimming="CharacterEllipsis" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="{DynamicResource L.Members_RemoveSelected}" Click="Remove_Click" MinWidth="100" MinHeight="28" Margin="0,0,8,0" />
            <!-- 「移动到…」的目标列表点开时才建：组的增删改名在窗口开着时不会发生（模态），
                 但弹出锚点必须落在按钮上、朝上开——按钮贴着窗口底边，朝下开会被裁掉。 -->
            <Button x:Name="MoveButton" Content="{DynamicResource L.Members_MoveSelected}" Click="MoveTo_Click"
                    MinWidth="100" MinHeight="28" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.Btn_Close}" IsCancel="True" MinWidth="84" MinHeight="28" />
        </StackPanel>
        <!-- 行模板与另外两棵勾选树共用 NodeRowTemplate（Themes/Components.xaml）。
             成员绿 / 冲突蓝 / 分隔符灰粗 三态也在那里——本页是唯一需要「成员绿」的树
             （它列的就是某个组的成员），该态同样不必在这里另写触发器。 -->
        <TreeView x:Name="Tree" Margin="10,4,10,0" ItemTemplate="{StaticResource NodeRowTemplate}" />
    </DockPanel>
</Window>
