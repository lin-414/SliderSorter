<Window x:Class="SliderSorter.Wpf.Views.RuleGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SliderSorter.Wpf.Services"
        Title="{DynamicResource L.RuleGroup_Title}" Width="600" Height="660" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource B.Window}"
        FontFamily="{StaticResource AppFont}" FontSize="13" Style="{StaticResource AppWindow}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="12,10,12,0" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{DynamicResource B.TextDim}"
                   Text="{DynamicResource L.RuleGroup_Explainer}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,8,10,10">
            <Button x:Name="PresetButton" Content="{DynamicResource L.RuleGroup_SavePresetBtn}" Click="SavePreset_Click" MinWidth="96" MinHeight="28" Margin="0,0,8,0" />
            <!-- 「关闭」必须显式处理点击：本窗口是 Show() 出来的非模态窗口，而 IsCancel 只在
                 ShowDialog() 的窗口上才有"关掉自己"的语义（WPF 的 DialogCancelCommand 对非模态窗口
                 什么都不做）。只挂 IsCancel 的后果就是按钮点下去毫无反应，只能用标题栏的 × 关。 -->
            <Button Content="{DynamicResource L.Btn_Close}" Click="Close_Click" MinWidth="84" MinHeight="28" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.Btn_Apply}" Style="{StaticResource PrimaryButton}" Click="Apply_Click" MinWidth="96" MinHeight="28" />
        </StackPanel>
        <Grid Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <!-- 按内容定宽：固定 96 是照中文标签（「模组关键字」约 65）定的，
                     换成英语的 Excluded keywords（122）或俄语的 Ключевые слова комплектов（197）
                     会整块向左溢出到窗口外——固定像素列并不约束子元素 -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <!-- 隐式 TextBlock 样式会断开窗口前景色继承，必须显式设置，否则暗色主题下是黑字 -->
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Margin" Value="0,0,10,0" />
                </Style>
                <!-- 必须基于主题隐式样式，否则本地样式会把下拉框模板整个盖掉（退回系统白底） -->
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Text="{DynamicResource L.RuleGroup_Target}" />
            <ComboBox x:Name="GroupCombo" Grid.Row="0" Grid.Column="1" DisplayMemberPath="Name" />
            <TextBlock Grid.Row="1" Text="{DynamicResource L.RuleGroup_Direction}" />
            <ComboBox x:Name="DirectionCombo" Grid.Row="1" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="{DynamicResource L.RuleGroup_Add}" />
                <ComboBoxItem Content="{DynamicResource L.RuleGroup_Remove}" />
            </ComboBox>
            <TextBlock Grid.Row="2" Text="{DynamicResource L.RuleGroup_ModKeywords}" />
            <TextBox x:Name="ModIncludeBox" Grid.Row="2" Grid.Column="1" Margin="0,3"
                     ui:Watermark.Text="{DynamicResource L.RuleGroup_WmMod}" />
            <TextBlock Grid.Row="3" Text="{DynamicResource L.RuleGroup_OutfitKeywords}" />
            <TextBox x:Name="OutfitIncludeBox" Grid.Row="3" Grid.Column="1" Margin="0,3"
                     ui:Watermark.Text="{DynamicResource L.RuleGroup_WmOutfit}" />
            <TextBlock Grid.Row="4" Text="{DynamicResource L.RuleGroup_ExcludeKeywords}" />
            <TextBox x:Name="OutfitExcludeBox" Grid.Row="4" Grid.Column="1" Margin="0,3"
                     ui:Watermark.Text="{DynamicResource L.RuleGroup_WmExclude}" />
            <TextBlock Grid.Row="5" Text="{DynamicResource L.RuleGroup_Scope}" />
            <CheckBox x:Name="UnassignedCheck" Grid.Row="5" Grid.Column="1" Content="{DynamicResource L.RuleGroup_UnassignedOnly}"
                      IsChecked="True" Margin="0,6" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock x:Name="PreviewLabel" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                       Foreground="{DynamicResource B.TextDim}" Margin="0,8,0,4" />
            <TreeView x:Name="PreviewTree" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <!-- 预览树只读（无勾选框），分隔符着色走共用的 NodeRowText：
                             它与本窗口 Grid.Resources 里那份隐式 TextBlock 样式是两回事——
                             后者只管"标签右对齐"这类表单排版，不该管树节点的语义着色。 -->
                        <TextBlock Text="{Binding Text}" Style="{StaticResource NodeRowText}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </DockPanel>
</Window>
