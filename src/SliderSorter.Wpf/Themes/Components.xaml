<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 共用组件层：由 App.xaml 在 Themes/Controls.xaml **之后**合并 ──
         这里的样式一律 BasedOn 到 Controls.xaml 里的基础样式，所以顺序不能反——
         反过来 BasedOn="{StaticResource {x:Type Button}}" 会在解析期找不到目标而抛异常。

         为什么单独一个文件：原先「分隔符变暗加粗」「冲突蓝」「占位行变暗」这三种着色
         在 4 个视图里各写一遍（GroupGenerationPage / NewModsWindow / GroupMembersWindow /
         RuleGroupWindow），三份树模板也是各写一份。同一种语义散在多处，改一处必然漏三处。
         收在这里之后，语义只有一份定义，视图只负责"这里是个分隔符行"。

         约束（与 Controls.xaml 相同，CI 门禁会查）：
         · 颜色一律经 DynamicResource 引用 B.* 键，不得硬编码；
         · 不得引用色板里不存在的键（verify_theme.py §4 会拦）；
         · 不新增色板键——新增键会绕过 verify_contrast.py 的对比度断言。 -->

    <!-- ══ 字阶（四级）══
         全项目原先散着 11/12/13/14/15/16/18 七个字号，其中真正承担语义的只有四级，
         多出来的两个差值全来自"同一层级各写各的"：段标题有 14 也有 16，
         辅助文字有 11 也有 12。同级不同号不会让任何门禁变红，
         却会让两页并排看时"总觉得哪里不齐"，而且每加一处就要重新决定一次该写几号。

         定成四级之后，规则是：**新增文本先判断属于哪一级，再引用这里的键**；
         只有等宽日志（MonoFont）与图标字形（如复选框里的 ✓）例外——
         它们是"字体驱动的尺寸"而非"信息层级"，写死字号反而是对的。

           H1 页标题      18  PageHeading          一页一个，最大
           H2 段/卡片标题  16  SectionTitle / SettingSectionHeader
           H3 正文        13  BodyText（= AppWindow 的字体大小，不必显式设）
           H4 辅助/徽标    11  CaptionText / CountBadgeText / NodeCountBadgeText

         归档时改掉的号（都是"同级各写各的"，不是有意分级）：
           · SettingSectionHeader    14 → 16（与 SaveSuccessWindow 标题同层）
           · 扫描遮罩标题            14 → 16（该卡片唯一的标题）
           · 扫描遮罩明细            12 → 11（与 CaptionText 同层）
           · 通知弹窗正文          13.5 → 13（手调值，直接回到 H3）
           · 设置页品牌字标 / 完成弹窗标题 → SectionTitleText

         留在阶梯外的三处（故意不归档，改动它们的字号会破坏别的东西）：
           · MonoFont 的日志框（GroupGenerationPage / SettingsPage 的 12）——
             等宽面配的是行高与列宽，字号跟着它们走；
           · Controls.xaml 里 MenuItem 的快捷键与 ✓（12）——
             是 WPF 原生模板的排版值，不是我们的信息层级；
           · IconButton 的「⋯」（15）—— 按钮的字号是在配图标字形的大小。
           这三处若哪天要动，请连着它们的载体一起看，不要只看字号。

         为什么把 SettingSectionHeader 从 14 提到 16：原先 14 是为了"不与页标题 18 争"，
         但同一层级里 16 已经在用（SaveSuccessWindow 的标题、设置页「关于」里的应用名），
         读者看到的是两页的段标题不一样大。统一到 16 之后，14 这一档整体取消——
         四级阶梯的间距（18/16/13/11）比七级更易分辨，也更易记。 -->

    <!-- H1 页标题：定义在 Controls.xaml 的 PageHeading（18 号），此处不重复定义——
         同名键会被 §7 门禁拦下（Components.xaml 后合并，重复定义等于静默覆盖）。 -->

    <!-- H2 段/卡片标题。「比正文大、比页标题小」是它的全部职责。 -->
    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- H4 辅助/徽标文字。计数、说明、状态这类"读得到但不是主角"的文字。 -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ── 节点行文本族 ──
         三个语义：分隔符（MO2 左侧栏的分组标题）/ 冲突（同名或输出冲突）/ 占位（"没有匹配"的提示行）。
         默认都回到 B.Text，由各自的触发器改色 —— 这样调用方不写任何触发器就是"普通行"。 -->

    <!-- 分隔符行：MO2 的分组标题，比服装行暗一档并加粗，起"层级分隔"而非"可选项"的观感 -->
    <Style x:Key="SeparatorRowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 冲突行：同名冲突（归属给优先级最高的模组）或输出冲突（写了同一个 .nif）。
         用 B.Conflict 独立成一色，与"已加入组"的绿、警告的橙都不撞 -->
    <Style x:Key="ConflictRowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.Conflict}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 占位行："没有符合筛选条件的服装"这类节点。不可勾选（调用方负责收起复选框），
         文字压暗表示"这不是一个真实条目" -->
    <Style x:Key="PlaceholderRowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ── 树节点行的完整文本样式：把上面三种语义叠加在一条链上 ──
         分隔符优先于冲突、冲突优先于占位 —— 与原先四处手写触发器的**叠加顺序**一致
         （原写法里三个 DataTrigger 并列，WPF 后写的覆盖先写的，所以实际生效顺序就是
         冲突 → 分隔符 → 占位；这里把它显式化，行为不变而意图可读）。 -->
    <Style x:Key="NodeRowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.Conflict}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
            </DataTrigger>
            <!-- 已加入当前组：绿色是"已处理"的正向信号，优先级最高，
                 否则一条既是成员又是分隔符的行会显示成灰色。 -->
            <DataTrigger Binding="{Binding IsMember}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.Member}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 节点行的复选框：占位行要收起（它不是一个可勾选的条目）。
         BasedOn 必须写全 {x:Type CheckBox}，否则会把 Controls.xaml 里的自绘模板整个盖掉，
         退回系统白底方框 —— 与 RuleGroupWindow 里 ComboBox 那条注释是同一个坑。 -->
    <Style x:Key="NodeRowCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── 计数徽标（节点行右侧的「组内 x/y」）──
         以前这段是拼进节点文本的，长模组名被 CharacterEllipsis 截断时会把计数一起吃掉，
         而"这个模组有多少已进组"恰恰是当时最需要看的信息。拆成独立 Border 之后它排在
         文本的**外侧**，无论名字多长都完整可见。
         小圆角 + 淡底 + 比正文小一号，是与"行文本"区分层级的最小做法；
         不用 B.Accent 这类高饱和色——它只是个计数，不该抢走冲突色/成员色的注意力。

         ⚠️ 键名必须与 Controls.xaml 里那套「橙色警告徽标」区分开。
         Controls.xaml 已有 CountBadge / CountBadgeText（B.WarnText 加粗，用于日志条数的警示），
         而 Components.xaml 是**后合并**的——同名键会静默覆盖前者，
         结果是 GroupGenerationPage 上那两颗警告徽标变成灰字细体，谁也不报错。
         2026-09-22 加节点徽标时就撞了一次，故加 Node 前缀标明作用域是「树节点行」。 -->
    <Style x:Key="NodeCountBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- 默认收起、有内容才显示。Hidden 而非 Collapsed 的理由见下方模板注释。
             用 DataTrigger 而不是转换器：Converts.cs 里没有 bool→Visibility，
             这里也不值得为一次比较新引一个类型进来（NodeRowCheckBox 同款做法）。 -->
        <Setter Property="Visibility" Value="Hidden" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasBadge}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NodeCountBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- 计数短且必须完整：不折行、不省略 -->
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- ── 节点行模板（三棵树共用）──
         行内容就是「勾选框 + 文本 [+ 计数徽标]」，三处视图原先各写一遍 HierarchicalDataTemplate。
         收成一份之后，视图侧只剩一句 ItemTemplate="{StaticResource NodeRowTemplate}"，
         行内结构（顺序、间距、占位行收起）只此一处定义。

         HierarchicalDataTemplate 而不是 DataTemplate：ItemsSource="{Binding Children}"
         是树展开子层级所必需的，漏了它模组展开后一个服装行都出不来。

         用 Grid 而不是横向 StackPanel（与 GroupGenerationPage 里那份同理）：
         横向 StackPanel 给子元素无限宽度，TextTrimming 永不触发，超长服装名会撑出横向滚动条。
         列宽是 Auto | * | Auto —— 文本列吃掉所有剩余宽度并在不够时省略，
         徽标列恒按内容取宽，于是"名字被截、计数完整"是布局保证而非巧合。

         徽标用 Hidden 而非 Collapsed 收起：与「已进组 ✔」那条同理，
         让有徽标/无徽标的行文字左边缘对齐是在勾选框右侧，而不是随徽标有无左右横跳。 -->
    <HierarchicalDataTemplate x:Key="NodeRowTemplate" ItemsSource="{Binding Children}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Style="{StaticResource NodeRowCheckBox}"
                      IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Text="{Binding Text}" ToolTip="{Binding Text}"
                       Style="{StaticResource NodeRowText}" />
            <Border Grid.Column="2" Style="{StaticResource NodeCountBadge}">
                <TextBlock Style="{StaticResource NodeCountBadgeText}" Text="{Binding BadgeText}" />
            </Border>
        </Grid>
    </HierarchicalDataTemplate>

    <!-- ══ FormField：设置页的表单行 ══
         四张卡片原来各自手写一遍「Auto(标签轨) | *(字段) | Auto(动作)」的三列定义 +
         SharedSizeGroup="SettingsRail"，四处必须逐字一致才能对齐——加一节漏写一次就错位。

         ⚠️ 为什么这里没有 FormGrid 样式：`Grid.ColumnDefinitions` **没有可访问的 setter**，
         放进 <Setter> 会直接编译失败（MC3080）。行定义同理。所以列定义只能在各视图里写，
         本文件负责的是**标签、字段、动作按钮、说明文字**这四类元素在行列里的定位与外观统一，
         列定义本身由视图照抄下面这段（四处一致即可，不一致时探针会对不齐的几何报警）：

           <Grid x:Name="XxxGrid" Grid.IsSharedSizeScope 由页根声明>
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsRail" />
                   <ColumnDefinition Width="*" />
                   <ColumnDefinition Width="Auto" />
               </Grid.ColumnDefinitions>

         标签轨靠 SharedSizeGroup 取全页最宽的那个标签，语言一变自己跟着变宽 ——
         定死像素会在法语「Langue de l’interface」下压窄标签，而探针正是按四语量这个的。 -->

    <!-- 字段行里的动作按钮（检测 / 浏览…）：「贴右、不参与拉伸」，
         而不是让它去挤字段列——字段列少 90px 时，BodySlide 路径就显示不全了。
         MinWidth 90 与既有手写值一致，四语下都放得下（探针验证）。 -->
    <Style x:Key="FieldAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 挂在字段行下方的说明文字（"有效项目路径：…"）：占满三列、压暗、可换行。
         不加 TextTrimming —— 路径必须能读全，过长时靠 MaxHeight + ToolTip 兜底。 -->
    <Style x:Key="FieldNote" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ══ 内联提示条（InlineBanner）══
         一排"图标 + 一句话 + 关闭"的窄条，贴在触发它的控件旁边，不遮内容、不抢焦点、
         不需要点"确定"。用来替掉那批纯提示性的模态框（"先选一个组"、"先勾选服装"、
         "没有可撤销的操作"）—— 它们的共同点是：用户要做的下一件事永远是"回到刚才那块控件"，
         而模态框恰好挡在那块控件上面。

         三种级别只用已有色板键，不新增键（新增键会绕过 verify_contrast.py 的断言）：
         Info → AccentSoft/AccentText（4.75:1，与"强调徽标"同一对）
         Warn → WarnSoft/WarnText（6.84:1）
         Danger → Danger 底、B.Navy 字；B.Navy 是"压在实色上的浅字"那一档，
         与 DangerSolid 上用的白字同族，暗色下是 #ECE0C8、亮色下是深色，两边都可读。

         结构：外层 Boarder 提供底色与圆角，内容由调用方填（这里给一个可复用的整体 DataTemplate）。 -->

    <!-- 提示条外框。Kind 决定底色与描边；未设置时按 Info -->
    <Style x:Key="InlineBannerBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.AccentBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="9,6" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource B.WarnSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource B.WarnText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource B.Danger}" />
                <Setter Property="BorderBrush" Value="{DynamicResource B.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 提示条正文。颜色跟着外框走：必须在同一个 Kind 上判断，
         不能只靠"继承外层前景"——Danger 的底色是实红，正文得单独换成 B.Navy。 -->
    <Style x:Key="InlineBannerText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource B.WarnText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Danger">
                <Setter Property="Foreground" Value="{DynamicResource B.Navy}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 整条提示的模板：Binding 上下文是 BannerMessage。
         关闭按钮用 × 而不是"确定"——它不表示"我看过了"，只表示"把这条挪开"，
         而提示本身会随着条件满足自动消失（条件不满足时也不该常驻）。 -->
    <DataTemplate x:Key="InlineBannerTemplate">
        <Border Style="{StaticResource InlineBannerBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource InlineBannerText}" Text="{Binding Text}" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="✕"
                        Command="{Binding DataContext.DismissBannerCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ToolTip="{DynamicResource L.Banner_Dismiss}"
                        Margin="8,0,0,0" VerticalAlignment="Top" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
