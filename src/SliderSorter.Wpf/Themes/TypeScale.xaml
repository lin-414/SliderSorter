<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ── 字阶基准值（四档，与 Components.xaml 顶部的字阶表一一对应）──
         字号 setter 一律 DynamicResource 引用这里的键，不许再写死数字。
         FontScaleManager 按用户选的缩放档**就地改写这四个值**（ThemeManager 换色板同一套
         热生效思路：改的是合并字典里的实际条目，订阅它的 DynamicResource 才会收到失效通知——
         写到 app 资源根上"遮住"默认值是靠不住的，运行期实测不传播）。

         ⚠️ 这份字典必须与 Controls/Components 一起出现在所有"手工合并 app 字典"的场合：
         App.xaml、WpfHost.AppDictionaries、layout-probe 的 LoadResources——少合并一份，
         离屏加载的页面字号就回落到 WPF 默认的 12。

         档位外的例外（等宽日志、图标字形）见 Components.xaml 字阶表，仍写死字号。 -->
    <sys:Double x:Key="Type.H1">18</sys:Double>
    <sys:Double x:Key="Type.H2">16</sys:Double>
    <sys:Double x:Key="Type.H3">13</sys:Double>
    <sys:Double x:Key="Type.H4">11</sys:Double>
</ResourceDictionary>
