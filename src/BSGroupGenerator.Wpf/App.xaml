<Application x:Class="BSGroupGenerator.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <!-- 色板（Palette.Light/Palette.Boutique）由 ThemeManager 在启动时按设置加载，
         控件样式在 Controls.xaml，颜色经 DynamicResource 跟随色板热切换。

         ⚠️ Components.xaml 必须排在 Controls.xaml **之后**：它里面的样式一律
         BasedOn="{StaticResource {x:Type ...}}" 到基础样式上，合并顺序反了会在解析期直接抛
         （找不到 StaticResource 目标）。两处都是 app 级字典，后者按加入顺序覆盖前者。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Components.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
