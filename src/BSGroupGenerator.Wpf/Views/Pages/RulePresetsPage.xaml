<UserControl x:Class="BSGroupGenerator.Wpf.Views.Pages.RulePresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 规则预设页：说明工作流，查看/编辑/删除已保存预设。
         「新建预设…」「编辑所选…」拉起的是规则归组编辑器（独立非模态窗口），
         它保存预设后回到这一页时列表会自己刷新（见 code-behind 的 IsVisibleChanged）。 -->
    <Grid Margin="12,6,12,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource L.RulePresets_Head}" FontWeight="Bold"
                       Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                       Foreground="{DynamicResource B.TextDim}"
                       Text="{DynamicResource L.RulePresets_Steps}" />
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="List" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                 MouseDoubleClick="List_DoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                   Foreground="{DynamicResource B.Text}" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource B.TextDim}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 居中的空状态提示必须允许换行：按内容宽度排列时会比面板还宽，两侧一起溢出 -->
        <TextBlock Grid.Row="1" x:Name="EmptyHint" Text="{DynamicResource L.RulePresets_Empty}"
                   Foreground="{DynamicResource B.TextDim}" FontStyle="Italic"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="16,0"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource L.RulePresets_New}" Click="NewPreset_Click" MinWidth="96" MinHeight="28"
                    Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
            <Button Content="{DynamicResource L.RulePresets_Edit}" Click="Edit_Click" MinWidth="96" MinHeight="28"
                    Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.RulePresets_Delete}" Click="Delete_Click" MinWidth="90" MinHeight="28" />
        </StackPanel>
    </Grid>
</UserControl>
