<UserControl x:Class="BSGroupGenerator.Wpf.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 设置页：单列自上而下四节——工作环境、输出设置、外观、帮助与关于
         （信息架构照搬 boutique 的 SettingsPanelView：页标题 + 纵向堆叠的分节卡片 + 全页共用一条标签轨）。

         标签轨靠 Grid.IsSharedSizeScope + 每节首列 SharedSizeGroup="SettingsRail" 对齐，
         而不是照抄 boutique 的 Width="140"：它的标签最长是英文， ours 是法语
         「Langue de l’interface」。定死 140 会在 fr/ru 下把标签压窄，而布局探针正是按
         4 语言 × 2 主题 × 三档尺寸量这个的（README 也写了不得按单一语言定死容器尺寸）。
         Auto + 共享组的取法是"全页取最宽的那个标签"，既对齐又随语言自己变宽。
         代价是四节几何被耦合：任一节冒出长标签会撑宽全页的标签列，
         真撑不住时该改的是译文或把该项拆成独立一节，不是给 FieldLabel 加 TextTrimming
         （探针刻意跳过 trim/wrap 元素，加了等于让门禁对这条轨失明）。

         卡片铺满整页，不设 MaxWidth：原先根 Grid 钉了 860 并居中，理由是"一列铺到 1068 的话，
         关于那段说明一行能排一百多字"。但那道限宽连同四张卡片一起从页面边缘缩进约 110，
         宽窗口下两侧各留一条空带，看着像没排完；另三页（分组生成 / 输出冲突 / 规则预设）
         都是 Margin="12" 直接铺满，只有设置页独树一帜。关于那两段各是两句话，
         铺满也就一到两行，换来四页左右边界齐平更值。外层 Margin 与另三页取同一档，
         切页时左边界不跳。

         限宽若将来要加回来，得写在根 Grid 而不是滚动区内部：垂直滚动条常驻，
         限在内层会让卡片比标题左边缘缩进约半个滚动条宽。写在外面，标题与四节
         同属一个内容盒，左边缘对齐是结构保证而非算术。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页标题复用 L.Tab_Settings：标题与标签头一旦是两个键就必然漂移 -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeading}" Margin="0,0,0,10"
                   Text="{DynamicResource L.Tab_Settings}" />

        <ScrollViewer Grid.Row="1" x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SectionsPanel" Grid.IsSharedSizeScope="True" Margin="0,0,0,12">

                <!-- ── ① 工作环境：MO2 实例与配置 Profile ── -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <!-- 段头是纯标题，不放动作：boutique 的 GroupBox 头也是纯的。
                             刷新 / 添加 MO2 目录 排在字段下方右侧——放进字段行的第三列会把
                             实例下拉压到 400 上下，实例名就念不全了（同一颗心路见「清理失效服装」）。 -->
                        <TextBlock Style="{StaticResource SettingSectionHeader}"
                                   Text="{DynamicResource L.Settings_Workspace}" />
                        <Grid x:Name="EnvGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsRail" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.Main_Instance}"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                      DisplayMemberPath="DisplayName" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.Main_Profile}"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="{DynamicResource L.Main_Refresh}" MinWidth="90" Margin="0,0,8,0"
                                        Command="{Binding RefreshInstancesCommand}" />
                                <Button Content="{DynamicResource L.Main_AddMo2Dir}" Click="AddMo2_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── ② 输出设置：BodySlide 目录、写到哪儿、以及本 Profile 的服装对账 ── -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingSectionHeader}"
                                   Text="{DynamicResource L.Settings_Output}" />
                        <Grid x:Name="OutputGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsRail" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.Main_BodySlide}"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding BodySlideDirs}" SelectedItem="{Binding SelectedBodySlide}" />
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Button Content="{DynamicResource L.Main_Detect}" Command="{Binding DetectBodySlideCommand}"
                                        MinWidth="90" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Button Content="{DynamicResource L.Main_Browse}" Click="BrowseBodySlide_Click"
                                        MinWidth="90" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.Main_Output}"
                                       Style="{StaticResource FieldLabel}" />
                            <!-- 下拉框铺满字段列、浏览… 落在第三列右对齐：与上面 BodySlide 那行同宽同边。
                                 原先这里是"定宽 200 的下拉框 + 紧跟其后的按钮"，卡片铺满整页之后
                                 右侧会空出大半行——本次要修的正是这种留白。 -->
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding WriteModes}" SelectedItem="{Binding SelectedWriteMode}"
                                      DisplayMemberPath="Label" />
                            <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource L.Main_Browse}"
                                    Command="{Binding BrowseForTargetCommand}" MinWidth="90" Margin="10,0,0,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding InfoLine}"
                                       Foreground="{DynamicResource B.TextDim}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="64" ToolTip="{Binding InfoLine}" />

                            <!-- 从「工具」菜单挪来：它改的是这个 Profile 的模组与服装对应关系，
                                 和上面那条 BodySlide 目录是同一件事的两头，且是低频动作。 -->
                            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" MinWidth="140"
                                    Margin="0,8,0,0" HorizontalAlignment="Right"
                                    Content="{DynamicResource L.Settings_CleanupStale}"
                                    Command="{Binding CleanupStaleMembersCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── ③ 外观 ──
                     以前是菜单栏顶层的两个勾选菜单项，图的是"点一下就切"。语言项的标签恒为各语言自己的
                     写法（中文 / English / Русский / Français）：界面被翻坏时，那是唯一还认得出来的线索。 -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingSectionHeader}"
                                   Text="{DynamicResource L.Settings_Appearance}" />
                        <Grid x:Name="AppearanceGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsRail" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 两颗下拉框也铺满字段列（原先定宽 220 左对齐）：内容短是真，
                                 但宽度得跟上面两节的字段列一致，否则"设置页的输入框"有两套宽度，
                                 而且定宽会在卡片里留出一条右边空带。 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.Settings_Theme}"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}"
                                      DisplayMemberPath="Label" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.Settings_Language}"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageOption}"
                                      DisplayMemberPath="Label" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── ④ 帮助与关于 ──
                     这一节是散文与折叠区，不是表单，所以不铺字段栅格、也就不占标签轨；
                     它的正文起点是卡片内容盒的左边缘，与前三节的标签同一条线。
                     使用说明 / 诊断信息 / 关于 / 检查更新 以前各是一个独立窗口，从菜单栏点出去。
                     内容都不大，摊在这一页里：少一层窗口，也少一次"关掉就找不回来"。 -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingSectionHeader}"
                                   Text="{DynamicResource L.Settings_Help}" />

                        <!-- 关于 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="../../app.ico" Width="40" Height="40" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <!-- 应用名是品牌字标，故意不进 Lang 文件（四语同形，且 verify_l10n 扫不到它）。
                                     16 而不是 18：页标题要是全页最大的字，否则一级层次读不出来。 -->
                                <TextBlock Text="BS Group Generator" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource B.Text}" />
                                <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource B.TextDim}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.Text}"
                                   Text="{DynamicResource L.About_Desc}" />
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource B.Text}">
                            <Hyperlink Click="Repo_Click" Foreground="{DynamicResource B.AccentText}"><Run
                                    Text="{DynamicResource L.About_Repo}" /></Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,10,0,0" Text="{DynamicResource L.About_Author}" Foreground="{DynamicResource B.Text}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource DimLabel}" TextWrapping="Wrap"
                                   Text="{DynamicResource L.About_Compat}" />

                        <Border Height="1" Background="{DynamicResource B.BorderSoft}" Margin="0,14" />

                        <!-- 检查更新：结果写在这行右边。「已是最新」不再单独弹框 -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource L.Settings_CheckUpdate}" Command="{Binding CheckUpdateCommand}"
                                    MinWidth="120" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource DimLabel}"
                                       TextWrapping="Wrap" Text="{Binding UpdateStatusText}" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource B.BorderSoft}" Margin="0,14" />

                        <!-- 使用说明：正文 60+ 段，收起时一份都不建（见 code-behind 的 ShowManual）。
                             箭头 + 折叠这两下照搬日志摘要的写法，不引 Expander——Controls.xaml 没有它的样式。 -->
                        <Button Click="ManualToggle_Click" Style="{StaticResource DisclosureToggle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource B.TextDim}" StrokeThickness="1.6"
                                      Margin="1,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsManualExpanded}" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{DynamicResource L.Settings_Manual}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="ManualHost" Height="360" Margin="0,6,0,0" Background="{DynamicResource B.Panel}"
                                BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding IsManualExpanded, Converter={StaticResource BoolToVis}}">
                            <FlowDocumentScrollViewer x:Name="ManualViewer" IsToolBarVisible="False"
                                                      VerticalScrollBarVisibility="Auto" />
                        </Border>

                        <Border Height="1" Background="{DynamicResource B.BorderSoft}" Margin="0,14" />

                        <!-- 诊断信息 -->
                        <Button Click="DiagnosticsToggle_Click" Style="{StaticResource DisclosureToggle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource B.TextDim}" StrokeThickness="1.6"
                                      Margin="1,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiagnosticsExpanded}" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{DynamicResource L.Diag_Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Grid x:Name="DiagnosticsHost" Margin="0,6,0,0"
                              Visibility="{Binding IsDiagnosticsExpanded, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" x:Name="ReportBox" Height="260" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Border}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="{DynamicResource L.Main_Refresh}" Click="DiagnosticsRefresh_Click"
                                        MinWidth="90" Margin="0,0,8,0" />
                                <Button Content="{DynamicResource L.Btn_CopyAll}" Click="DiagnosticsCopy_Click" MinWidth="90" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
