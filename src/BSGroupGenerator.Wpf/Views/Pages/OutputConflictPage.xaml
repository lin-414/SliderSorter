<UserControl x:Class="BSGroupGenerator.Wpf.Views.Pages.OutputConflictPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BSGroupGenerator.Wpf.Services">
    <!-- 输出冲突与选择页：多个模组的服装写同一个 .nif 时，为每一组指定由谁来生成
         （对应 BodySlide 批建时那个"以下 set 会覆盖同样的文件"的弹窗）。
         原先这是从菜单点出来的模态窗口，现在是壳的四个标签页之一：
         没有「关闭」按钮，也没有"关掉就找不回来"——入口是标签头本身，以及状态栏上那段可点击的冲突计数。

         ── 版式（2026-09-22 重排）──
         自上而下四行：一句话说明（右侧挂进度）→ 工具条 → 三栏 → 操作行。
         三处是特意定下的：
         ① 页内不复述标签页的名字。原先这里挂着 18px 的 PageHeading，写的就是标签头那句
            「输出冲突与选择」——同一行字在 30px 内出现两次，第二次只是把说明段往下推了一行。
            现在这一页与另三页同构：内容起头就是说明段，页名只由标签头承担。
            进度读数原先挂在页标题右侧，标题撤掉后它跟着说明段同行右对齐，不再独占一条空带。
         ② 过滤框与「只看跨模组」提到全页宽的工具条上，不再是左栏顶部的一块。
            原先它们把左栏列表往下推，而中栏标题占两行、右栏预览卡自带标题栏，
            三栏的内容起点因此错成 49 / 108 / 129 三档阶梯，右栏看着像凭空高出一块。
            现在三栏的列头同占一行 Grid.Row=0（行高取三者最大），内容一律从同一 y 开始。
         ③ 左栏每行不再整条输出路径。原样是「输出文件：meshes\actors\character\character assets\
            clothes\<名>_0.nif」，346px 宽下折 2–5 行：前缀人人相同、区分不了任何两行，
            行高却到了 62–96px。现在主行是文件名、次行是状态（未指定用警示色），
            完整路径进 ToolTip（左栏每行与中栏列头都是），中栏列头另给完整的输出文件名。

         ── 左栏按用户分组分类（2026-09-23）──
         左栏从平铺一层变成两级：用户自己的分组（「分组生成」页那批）当分组头，其下是
         "有该组成员卷入"的冲突行；没进任何分组的冲突收在「未入组」桶里。
         一条冲突可能同时挂在多个分组下（它确实同时影响那几个组的批建结果：赢家全局只有一个），
         所以"当前列出了 N 组"按冲突去重算、不数行。分类规则见 OutputConflicts.CategorizeByUserGroup；
         工具条上那颗「只看某组」是同一份数据的快捷入口。 ── -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ── 分组头的右键菜单：整列分组的展开/折叠（与「分组生成」页左侧模组树的同名菜单一致）──
             挂在这一页唯一"会折叠的东西"上，也就是分组头那条折叠条（见下面 GroupItem 模板里的
             ContextMenu）：冲突行是叶子，没有可展开的下级，把菜单挂到行上只会让「折叠其他」
             失去锚点。

             三个动作都是**整列**的，所以用 Click 处理器而不是命令——命令得挂在 DataContext 上，
             而 ContextMenu 是资源里的共享实例、不在逻辑树上（模板里的 DataContext 是
             CollectionViewGroup 而不是行对象），处理器再经 PlacementTarget 找回"被右键的是哪一组"
             （见 OutputConflictPage.xaml.cs 的 MenuAnchor）。用命令还得为这个文件登记一份
             绑定对照表，而这份表的 DataContext 类型是 MainViewModel，对不上模板级的 DataContext。

             文案复用模组树那三个键：动作与语义完全相同（「折叠其他」= 右键的那一组保持展开）。 -->
        <ContextMenu x:Key="ConflictGroupMenu">
            <MenuItem Header="{DynamicResource L.Tree_ExpandAll}" Click="ExpandAllGroups_Click" />
            <MenuItem Header="{DynamicResource L.Tree_CollapseAll}" Click="CollapseAllGroups_Click" />
            <MenuItem Header="{DynamicResource L.Tree_CollapseOthers}" Click="CollapseOtherGroups_Click" />
        </ContextMenu>

        <!-- ── 分组头的内容 ──
             外框（B.Panel 底、下边框、箭头、悬停）在 Controls.xaml 的 ConflictGroupHeaderToggle 里，
             这里只放"头里写什么"。拆开是因为外框要在 IsChecked 上画箭头，而那属于折叠条这个控件；
             内容则是本页的版式。

             模板的 DataContext 是 CollectionViewGroup 而不是行对象，所以文案与计数必须事先拼在
             Name（= ConflictGroupKey）上——模板拿不到页面里的行集合，而"该组有几处冲突"必须跟着
             过滤词走（显示 3 处、下面挂 1 行会自相矛盾）。
             名字列吃剩余宽度并截断、计数列恒按内容取宽（同列表行的做法：
             长组名被截时，最有信息量的那个数字不能跟着消失）。 -->
        <DataTemplate x:Key="ConflictGroupHeader">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name.Label}"
                           ToolTip="{Binding Name.Label}"
                           Style="{StaticResource SectionHeader}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name.CountText}"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource DimLabel}"
                           TextTrimming="CharacterEllipsis" />
                <!-- 「组内互撞」只在有这种冲突时出现：没有就整行收起，
                     否则每个分组头都多挂一条空的 13px 行。
                     收起状态下也照显——那时它是这一组仅剩的"里头什么情况"的线索。 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Name.IntraText}" Margin="0,2,0,0"
                           Foreground="{DynamicResource B.WarnText}"
                           ToolTip="{DynamicResource L.Conflict_IntraGroupTip}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Name.HasIntra, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="12,6,12,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 行 0：一句话说明 + 进度读数 ──
             标签头原先还挂着一枚冲突计数徽标，去掉了：那枚数字是"扫描到几组冲突"，
             跟"还剩多少没处理"不是一回事，挂在标签头既挤又容易被误读。
             进度放在这里——它只在这页有意义，而且紧挨着操作它的控件。 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="IntroLabel" TextWrapping="Wrap"
                       Style="{StaticResource DimLabel}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ProgressLabel" Style="{StaticResource DimLabel}" />
                <!-- 还有没指定的组才出现：全指定完还挂着一条"未指定 0"是噪声 -->
                <TextBlock x:Name="UnresolvedLabel" Margin="8,0,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource B.WarnText}" />
            </StackPanel>
        </Grid>

        <!-- ── 行 1：工具条。过滤、范围、重扫 ──
             星分 + MaxWidth 而不是"过滤框定宽 320"：宽窗口下输入框跟着长（够长才看得见输入的内容），
             窄窗口下它先让，重扫按钮始终贴右边缘（右列也是星分，按钮自己右对齐）。 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="FilterBox" MinWidth="140"
                     ui:Watermark.Text="{DynamicResource L.Conflict_Filter}" />
            <!-- 同一模组内部的多个预设共用一个输出文件（一件衣服几百个配色）也是冲突，
                 但那不是"多个模组改了同一件衣服"，默认先藏起来 -->
            <CheckBox Grid.Column="1" x:Name="OnlyCrossCheck" Margin="10,0,0,0" VerticalAlignment="Center"
                      Content="{DynamicResource L.Conflict_OnlyCrossMod}"
                      Checked="OnlyCross_Changed" Unchecked="OnlyCross_Changed" />
            <!-- 只看某个分组：左栏的分组头已经把冲突按组分好了，这一颗是"我只关心这一组"的快捷方式。
                 只列真的有冲突的分组（一个三十组的用户不该在选项里翻三十行才找到那两组），
                 可选项不足两个时整颗收起——那时它与"全部分组"等价，只是噪声。
                 MaxWidth 是给超长组名兜底：超过就截，不然一颗下拉能把重扫按钮挤出工具条。
                 Height 不能省：本项目的下拉框是自绘模板（Controls.xaml 的 ComboBox），
                 模板里那层 Border 只按 ToggleButton 里那个 8px 箭头取高，不给高度就只剩一行字那么矮，
                 夹在 34 高的输入框与按钮之间像没画完（探针只查溢出/压窄，不查"比邻座矮一截"）。
                 取 30 与 FieldCombo（设置页、规则归组窗）同一档。 -->
            <ComboBox Grid.Column="2" x:Name="GroupFilterBox" Margin="10,0,0,0" MinWidth="120" MaxWidth="200"
                      Height="30" VerticalAlignment="Center" SelectionChanged="GroupFilter_Changed"
                      ToolTip="{DynamicResource L.Conflict_GroupFilterTip}" />
            <TextBlock Grid.Column="3" x:Name="FilterCountLabel" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource DimLabel}" TextTrimming="CharacterEllipsis" />
            <!-- 冲突清单是扫描的产物：页面上的「自动选择」改的是本工具的设置，不会重扫。
                 以前模态窗口每次都是新开的、天然新鲜，改成常驻页就得自己留一个重扫入口。 -->
            <Button Grid.Column="4" x:Name="RescanButton" Content="{DynamicResource L.Conflict_Rescan}"
                    Command="{Binding DetectBodySlideCommand}" HorizontalAlignment="Right"
                    MinWidth="110" Margin="12,0,0,0" />
        </Grid>

        <!-- ── 行 2：三栏（冲突组 | 候选 | 预览） ──
             列按星分而不是固定像素：以前这个窗口自己 MinWidth=940，而 320+10+240+12+400
             这套固定列实际要 982 才排得下——最小尺寸下预览栏早就被裁掉了，只是没人拿最小尺寸去量。
             星分配合 MinWidth 下限：窄到极限时是预览让（280），不是把某栏挤没。 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.2*" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="0" />
            </Grid.RowDefinitions>

            <!-- 列头同行：三栏内容因此从同一条线开始。每行都是"粗体标签 + 暗色补充"，
                 一律 TextTrimming 单行——折行会让这一行对不上别的栏目。
                 VerticalAlignment=Top 不能省：SectionHeader 自带 VerticalAlignment=Center，
                 中栏的列头是两行、另两栏只有一行，行高取最大时居中的那两行会比中栏第一行低 10px。 -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6"
                        VerticalAlignment="Top">
                <TextBlock Style="{StaticResource SectionHeader}"
                           Text="{DynamicResource L.Conflict_GroupsHeader}"
                           ToolTip="{DynamicResource L.Conflict_GroupsHeaderTip}" />
                <TextBlock x:Name="GroupsCountLabel" Margin="6,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource DimLabel}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SectionHeader}"
                               Text="{DynamicResource L.Conflict_CandidatesHeader}" />
                    <TextBlock x:Name="CandidateCountLabel" Margin="6,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource DimLabel}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- 这一栏是"正在给哪个文件选人"，所以第二行写输出文件名。
                     不写整条路径：最小窗口下这一行只有 348px，从尾截断会正好切掉文件名——
                     那恰恰是唯一有区分度的部分（目录前缀在实战里人人都一样）。
                     完整路径在悬停提示里，左栏每行的提示也是它。 -->
                <TextBlock x:Name="TargetLabel" Margin="0,3,0,0" Style="{StaticResource DimLabel}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,6"
                        VerticalAlignment="Top">
                <TextBlock Style="{StaticResource SectionHeader}"
                           Text="{DynamicResource L.Conflict_PreviewHeader}" />
                <TextBlock x:Name="PreviewTitle" Margin="6,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource DimLabel}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 左：冲突组。两行——文件名（主标识）+ 状态。
                 有分组时按用户自己的分组分类（分组头 + 其下的冲突行），见 GroupStyle 的注释。 -->
            <ListBox Grid.Row="1" Grid.Column="0" x:Name="GroupList" SelectionChanged="GroupList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <!-- ── 分组头：可折叠的折叠条（用户分组名 + 该组名下的冲突数）──
                     整条是 ToggleButton（样式见 Controls.xaml 的 ConflictGroupHeaderToggle），
                     勾选态 = 展开态，于是屏幕阅读器与键盘用户都能用；箭头由样式按 IsChecked 画。
                     头里写什么见资源里的 ConflictGroupHeader 模板。

                     折叠只影响**显示**，不影响批量操作的作用范围：VisibleGroups() 读的是
                     ItemsSource（整个视图），收起的分组照样算进"对当前列出的 N 组"——
                     收起是"我先不看它"，不是"我不管它"。

                     右键这条头 = 整列的展开/折叠（ConflictGroupMenu），折叠分组多时不必逐个点。 -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel>
                                                <!-- IsChecked 双向绑到键对象上：勾选态由页面重建时按设置里
                                                     记的"收起"初始化，用户点一下就写回设置（见 ConflictGroupKey）。
                                                     不用 HeaderTemplate 而用 ContentTemplate：头的模板要给
                                                     ToggleButton 当内容用，HeaderTemplate 只会挂到 GroupItem 上。 -->
                                                <ToggleButton Style="{StaticResource ConflictGroupHeaderToggle}"
                                                              ContextMenu="{StaticResource ConflictGroupMenu}"
                                                              IsChecked="{Binding Name.IsExpanded, Mode=TwoWay}"
                                                              Content="{Binding}"
                                                              ContentTemplate="{StaticResource ConflictGroupHeader}" />
                                                <!-- 收起时把行整段藏起来（Collapsed 而不是 Hidden：
                                                     留着占位的话分组之间会空一大块）。 -->
                                                <ItemsPresenter Visibility="{Binding Name.IsExpanded,
                                                    Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 用 Grid 而不是横向 StackPanel：横向 StackPanel 给子元素无限宽度，
                             TextTrimming 永不触发，长文件名会把「组内互撞」徽标挤出左栏。
                             列宽 * | Auto —— 文件名被截、徽标完整，是布局保证而非巧合。 -->
                        <Grid Margin="2,3,2,3" ToolTip="{Binding Path}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                       Foreground="{DynamicResource B.Text}"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- 「组内互撞」：这个分组自己就有 2 个以上成员在争这个输出文件。
                                 底色压卡片底只有 1.1–1.5:1，光靠底色立不成"徽标"，故加一道同色描边
                                 （与中栏那两枚徽标同一做法）；字号取 11 而不是正文 13——
                                 俄语/法语译名比中文长得多，13 号会把左栏的文件名挤没。 -->
                            <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" Padding="5,0"
                                    CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource B.WarnSoft}"
                                    BorderBrush="{DynamicResource B.WarnText}" BorderThickness="1"
                                    ToolTip="{DynamicResource L.Conflict_IntraGroupTip}"
                                    Visibility="{Binding IntraVisibility}">
                                <TextBlock Text="{DynamicResource L.Conflict_IntraGroup}" FontSize="11"
                                           Foreground="{DynamicResource B.WarnText}" />
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Status}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <!-- 未指定用警示色：一眼看出还有哪些组没处理完。
                                         选中行的底色是 B.Selected，警示色与暗色次要色压它只有 3.4:1，
                                         所以选中行一律回到 B.Text（5.45:1）——见下面最后一条触发器。 -->
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DimLabel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Resolved}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource B.WarnText}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected,
                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 中：候选。也是一个两行网格：第一行是服装名（要选的就是它，独占整行），
                 第二行才是模组 · 层号 + 两个徽标。原先名字、信息、徽标全挤一行，
                 名字列被压到 MinWidth 90px 恒定截断，而徽标吃掉 153px。 -->
            <ListBox Grid.Row="1" Grid.Column="2" x:Name="CandidateList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="CandidateList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 右键整行 = 设为赢家：指针本来就停在意的那一行上，不该逼用户去瞄准那个小圆圈。
                             行根套一层 Border 而不是直接拿 Grid 当根，是为了给「不指定」那一行加一条上分隔线；
                             处理器仍挂在里面那个 Grid 上——MouseRightButtonUp 是 Direct 路由事件，
                             挂在 Border 上时"在某一行内部 raise"就传不上来（单测正是这么模拟右键的）。 -->
                        <Border Background="Transparent" Padding="2,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOptOut}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
                                            <Setter Property="BorderThickness" Value="0,1,0,0" />
                                            <Setter Property="Margin" Value="0,4,0,0" />
                                            <Setter Property="Padding" Value="2,8,2,4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MouseRightButtonUp="Row_RightClick">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <RadioButton Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" GroupName="ConflictWinner"
                                             IsChecked="{Binding IsWinner, Mode=OneWay}" Click="Winner_Click"
                                             VerticalAlignment="Top" Margin="0,1,8,0" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Label}"
                                           Foreground="{DynamicResource B.Text}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                <!-- 第二行三列：模组·层号吃剩余宽度并截断，两个徽标定宽排在右边。
                                     不能在横向 StackPanel 里放这一段：它给子元素无限宽度，
                                     截断永远不触发，长服装名会把徽标挤出窗口，
                                     而徽标正是"这条能不能选它"的关键信息 -->
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Info}" Margin="0,0,6,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Info}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DimLabel}">
                                                <Style.Triggers>
                                                    <!-- 选中行底纹上暗色次要文字只有 3.4:1，回到 B.Text -->
                                                    <DataTrigger Binding="{Binding IsSelected,
                                                        RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 两枚徽标各加一道同色描边：底纹（AccentSoft / WarnSoft）压卡片底
                                         只有 1.1–1.5:1，亮色主题下更近乎看不见，光靠底色立不成"徽标" -->
                                    <Border Grid.Column="1" Background="{DynamicResource B.AccentSoft}" CornerRadius="4"
                                            BorderBrush="{DynamicResource B.AccentBorder}" BorderThickness="1"
                                            Padding="5,0,5,1" Visibility="{Binding GroupedVisibility}">
                                        <TextBlock Text="{DynamicResource L.Conflict_InGroup}"
                                                   Foreground="{DynamicResource B.AccentText}" />
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource B.WarnSoft}" CornerRadius="4"
                                            BorderBrush="{DynamicResource B.WarnText}" BorderThickness="1"
                                            Padding="5,0,5,1" Margin="6,0,0,0" Visibility="{Binding StrongestVisibility}">
                                        <TextBlock Text="{DynamicResource L.Conflict_Strongest}"
                                                   Foreground="{DynamicResource B.WarnText}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 右：3D 预览。读该 set 的源网格（BodySlide 建它时读的同一个 .nif）。
                 只读不改，拖动转视角、滚轮缩放、右键一行即把该模组设为赢家 -->
            <Border Grid.Row="1" Grid.Column="4" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                    CornerRadius="6" Background="{DynamicResource B.Card}" Padding="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 视口分两层，几何完全一致、只切上层的可见性——切候选时控制行因此不会上下跳。
                         上层才是渲染面，底色用 B.Viewport（两套主题同值，理由见色板里的注释）：
                         底色带色调会给衣服染上一层不存在的颜色。
                         空着的时候不铺这层灰：365×492 的强对比灰面只放一枚说明气泡，
                         就成了全页最重的一块（亮色下它是整页最暗的 492px、占该面积 1.5%）。
                         这时露出下层 B.Panel（近卡面的浅色），读起来是"这里还没东西"。
                         说明文字是一枚 B.Card 气泡，靠 1px B.CheckBorder 成形、文字用 B.Text——
                         亮色主题下 Card 与 Panel 同为白，描边就是它唯一的分界，不能省。 -->
                    <Grid Grid.Row="0" x:Name="ViewportHost" SizeChanged="Viewport_Resized"
                          MouseLeftButtonDown="Viewport_DragStart" MouseMove="Viewport_Drag"
                          MouseLeftButtonUp="Viewport_DragEnd" MouseWheel="Viewport_Zoom"
                          MouseRightButtonDown="Viewport_RightDragStart" MouseRightButtonUp="Viewport_DragEnd">
                        <Grid.ToolTip>
                            <TextBlock Text="{DynamicResource L.Conflict_PreviewTip}" TextWrapping="Wrap" MaxWidth="360" />
                        </Grid.ToolTip>
                        <!-- 两层的上两角都要跟着外框那 6px 收：Border 的圆角不裁剪子元素，
                             这两块矩形底不自己收角就会把外框的圆角盖成方的。
                             下两角留方：卡片底部有 7px 内边距，视口本来就不碰那条边。 -->
                        <Border Background="{DynamicResource B.Panel}" CornerRadius="6,6,0,0" />
                        <Border x:Name="ViewportSurface" Background="{DynamicResource B.Viewport}"
                                CornerRadius="6,6,0,0" Visibility="Collapsed">
                            <Viewport3D x:Name="Preview" ClipToBounds="True">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera x:Name="Camera" FieldOfView="32" />
                                </Viewport3D.Camera>
                                <ModelVisual3D x:Name="LightVisual" />
                                <ModelVisual3D x:Name="MeshVisual" />
                            </Viewport3D>
                        </Border>
                        <!-- 气泡的描边用 B.CheckBorder 而不是 B.Border：亮色主题下 C.Panel 与 C.Card 同为白，
                             气泡正落在"无网格时 B.Panel 托底"上，用 Border 描边只剩 1.17:1——
                             恰恰是最需要说清的"没有源网格"这一态退化成白底白框。
                             CheckBorder 的定位就是"必须压 Card/Panel/Window ≥3:1 的中性描边"，正好是这里要的。 -->
                        <Border x:Name="PreviewStatusBubble" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.CheckBorder}"
                                BorderThickness="1" CornerRadius="5" Padding="10,5" MaxWidth="260"
                                Visibility="Collapsed">
                            <TextBlock x:Name="PreviewStatus" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource B.Text}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,6,8,0">
                        <Button x:Name="ResetButton" Content="{DynamicResource L.Preview_Reset}" Click="Reset_Click"
                                MinWidth="80" MinHeight="24" Padding="8,2" />
                        <!-- 打底身体：实测 68% 的 set 里没有身体（披风/手套/靴子/项链），光看就是一具悬空的壳；
                             但另外 32% 作者已经把身体一起导出了，再垫就是两层皮肉互相穿插。
                             所以默认「自动」——自带就不垫，没带才补一个女体，男体留给 HIMBO 那类。 -->
                        <TextBlock x:Name="BodyLabel" Text="{DynamicResource L.Preview_Body}" Margin="10,0,4,0"
                                   VerticalAlignment="Center" Style="{StaticResource DimLabel}" />
                        <ComboBox x:Name="BodyChoice" MinWidth="86" MinHeight="24" VerticalAlignment="Center"
                                  SelectionChanged="BodyChoice_Changed" />
                    </StackPanel>

                    <!-- 统计单独占一行，不再和按钮抢同一行的宽度：
                         原先它与复位按钮、身体下拉并排，最小窗口下只剩 76px，
                         有值时"12 480 三角形 · 3 个形状 · 3 个有贴图"必被截断。
                         没网格时统计整行收起（代码里置 Visibility），否则会留一条 27px 的隐形空行 -->
                    <TextBlock Grid.Row="2" x:Name="MeshStats" Margin="8,4,8,0" Visibility="Collapsed"
                               Style="{StaticResource DimLabel}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- 还没扫描（或扫完发现真的一组冲突都没有）时，三栏全是空列表，看着像卡住了。
                 可见性由本页的 _request 决定，不看 VM 的 CurrentConflict：
                 单测与宿主之外的调用方可以只喂一份清单进来，那时 VM 上什么都没有。
                 原先挂在 VM 上时，这两种状态会同时出现——满列表上飘着一句"还没有可显示的冲突"。 -->
            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="5"
                       x:Name="EmptyStateLabel" Visibility="Collapsed"
                       Style="{StaticResource EmptyStateText}" Text="{DynamicResource L.Conflict_NoRequest}" />
        </Grid>

        <!-- ── 行 3：操作行 ──
             批量动作（作用于"当前列出的这些组"）收在左半边并自带范围说明，
             提交动作「写入 BodySlide…」独占右端——原先三者与「重新扫描」混在一行，
             左一颗孤零零、中间 635px 空着、右边三颗抱团，看不出哪颗管什么。
             中间那段留白现在放一句"这颗按钮会写出什么"，把主按钮的后果写在它旁边。 -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="BatchScopeLabel" Style="{StaticResource DimLabel}" VerticalAlignment="Center"
                           Margin="0,0,2,0" TextTrimming="CharacterEllipsis" />
                <Button x:Name="AutoButton" Content="{DynamicResource L.Conflict_AutoAll}" Click="Auto_Click"
                        MinWidth="140" MinHeight="28" Margin="0,0,8,0" />
                <Button x:Name="ClearButton" Content="{DynamicResource L.Conflict_ClearAll}" Click="Clear_Click"
                        MinWidth="140" MinHeight="28" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                       Style="{StaticResource DimLabel}" TextWrapping="NoWrap"
                       Text="{DynamicResource L.Conflict_ExportHint}" />
            <Button Grid.Column="3" x:Name="ExportButton" Content="{DynamicResource L.Conflict_Export}"
                    Click="Export_Click" Style="{StaticResource PrimaryButton}" MinWidth="150" MinHeight="28" />
        </Grid>
    </Grid>
</UserControl>
