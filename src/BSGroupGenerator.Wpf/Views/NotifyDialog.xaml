<Window x:Class="BSGroupGenerator.Wpf.Views.NotifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" MinHeight="120"
        Background="{DynamicResource B.Window}" FontFamily="{StaticResource AppFont}" FontSize="13"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- 图标用 Path 自绘（不是系统图标位图），颜色一律走色板键，暗色主题下不会冒出白框 -->
    <Grid Margin="20,18,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Path Grid.Row="0" Grid.Column="0" Width="32" Height="32" Margin="0,1,14,0"
              VerticalAlignment="Top" HorizontalAlignment="Left"
              StrokeThickness="2" StrokeLineJoin="Round"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Style>
                <Style TargetType="Path">
                    <!-- 默认 = 信息：圆圈 + 竖杠与圆点组成的 "i" -->
                    <Setter Property="Data" Value="M 16 2 A 14 14 0 1 0 16 30 A 14 14 0 1 0 16 2 Z M 16 13 L 16 24 M 16 8 L 16 9" />
                    <Setter Property="Stroke" Value="{DynamicResource B.AccentText}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                            <Setter Property="Data" Value="M 16 3 L 29 27 L 3 27 Z M 16 12 L 16 20 M 16 23.5 L 16 24.5" />
                            <Setter Property="Stroke" Value="{DynamicResource B.WarnText}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                            <Setter Property="Data" Value="M 16 2 A 14 14 0 1 0 16 30 A 14 14 0 1 0 16 2 Z M 11 11 L 21 21 M 21 11 L 11 21" />
                            <Setter Property="Stroke" Value="{DynamicResource B.Danger}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Question">
                            <Setter Property="Data" Value="M 16 2 A 14 14 0 1 0 16 30 A 14 14 0 1 0 16 2 Z M 12 12.5 A 4 4 0 1 1 16 18 L 16 21 M 16 24.5 L 16 25.5" />
                            <Setter Property="Stroke" Value="{DynamicResource B.AccentText}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
        </Path>

        <!-- 正文走字阶的 H3（13，即 AppWindow 继承下来的字号），此处不显式设 FontSize：
             原先写 13.5，是"比 13 大一点点"的手调值——既不属于任何一级，也没人能记住，
             于是每加一个弹窗就要再决定一次写几号。保留 LineHeight 是为了多行正文的呼吸感，
             那是行距不是字阶，不受四级阶梯约束。 -->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                   Foreground="{DynamicResource B.Text}" LineHeight="20"
                   VerticalAlignment="Top" />

        <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,14,0,0"
                  Content="{DynamicResource L.Dlg_DontAskAgain}"
                  IsChecked="{Binding DontAsk}"
                  Visibility="{Binding ShowDontAsk, Converter={StaticResource BoolToVis}}" />

        <!-- 主按钮放最右（与完成弹窗一致）：顺序集中在这里，将来要按语言翻转也只改一处 -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding SecondaryText}" MinWidth="88" MinHeight="28" Margin="0,0,8,0"
                    Click="Secondary_Click"
                    Visibility="{Binding ShowSecondary, Converter={StaticResource BoolToVis}}" />
            <Button Content="{DynamicResource L.Btn_Cancel}" MinWidth="88" MinHeight="28" Margin="0,0,8,0"
                    IsCancel="True"
                    Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}" />
            <Button x:Name="PrimaryButton" Content="{Binding PrimaryText}" MinWidth="88" MinHeight="28"
                    IsDefault="True" Click="Primary_Click" />
        </StackPanel>
    </Grid>
</Window>
