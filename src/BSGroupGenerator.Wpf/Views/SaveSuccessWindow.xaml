<Window x:Class="BSGroupGenerator.Wpf.Views.SaveSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.SaveOk_Title}" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource B.Window}"
        FontFamily="{StaticResource AppFont}" FontSize="13" Style="{StaticResource AppWindow}">
    <StackPanel Margin="18">
        <!-- 标题走字阶的 H2（SectionTitleText，16）：与设置页的段标题同号 -->
        <TextBlock Text="{DynamicResource L.SaveOk_Heading}" Style="{StaticResource SectionTitleText}" />
        <TextBlock x:Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource B.Text}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,4">
            <Button x:Name="OpenOut" Click="OpenOut_Click" MinWidth="110" MinHeight="28" Margin="0,0,8,0" />
            <Button x:Name="OpenBs" Click="OpenBs_Click" MinWidth="130" MinHeight="28" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.Btn_Ok}" IsDefault="True" Click="Ok_Click" MinWidth="80" MinHeight="28" />
        </StackPanel>
    </StackPanel>
</Window>
