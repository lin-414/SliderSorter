<Window x:Class="BSGroupGenerator.Wpf.Views.RulePresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.RulePresets_Title}" Width="620" Height="460" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource B.Window}"
        FontFamily="{StaticResource AppFont}" FontSize="13" Style="{StaticResource AppWindow}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="{DynamicResource L.RulePresets_New}" Click="NewPreset_Click" MinWidth="96" MinHeight="28"
                    Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
            <Button Content="{DynamicResource L.RulePresets_Edit}" Click="Edit_Click" MinWidth="96" MinHeight="28"
                    Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.RulePresets_Delete}" Click="Delete_Click" MinWidth="90" MinHeight="28" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.Btn_Close}" IsCancel="True" MinWidth="84" MinHeight="28" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
            <TextBlock Text="{DynamicResource L.RulePresets_Head}" FontWeight="Bold"
                       Foreground="{DynamicResource B.Text}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                       Foreground="{DynamicResource B.TextDim}"
                       Text="{DynamicResource L.RulePresets_Steps}" />
        </StackPanel>
        <Grid Margin="12,0,12,10">
            <ListBox x:Name="List" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                     MouseDoubleClick="List_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                       Foreground="{DynamicResource B.Text}" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource B.TextDim}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 居中的空状态提示必须允许换行：按内容宽度排列时会比窗口还宽，两侧一起溢出 -->
            <TextBlock x:Name="EmptyHint" Text="{DynamicResource L.RulePresets_Empty}"
                       Foreground="{DynamicResource B.TextDim}" FontStyle="Italic"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="16,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</Window>
